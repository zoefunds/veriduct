    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "genlayer": "0.39.1",
    "typescript": "5.7.2"
  },
  "engines": { "node": ">=20" }
}
